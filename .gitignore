# --- 웹 ---------------------------------------------------------------------
node_modules/
web/dist/

# 배포할 때 npm 에서 받아 오는 글꼴 (web/scripts/fetch_fonts.py). 한글 글꼴은
# 한 벌이 2~14MB 이고 바이너리는 델타 압축이 먹지 않아 한 번 커밋하면 이력에서
# 되돌릴 방법이 없다 — 판본은 그 스크립트가 못박는다.
web/public/fonts/

# 실제 브라우저로 돌리는 검사(web/scripts/check-*.mjs)가 남기는 산출물
.cache/

# --- 파이썬 -------------------------------------------------------------------
.venv/
__pycache__/
*.pyc

# wrangler 가 남기는 임시 자리 (dry-run 산출물·로컬 상태)
.wrangler/
